<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KS"
                android:textColor="#FF6B00"
                android:textSize="52sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECOIL CONTROL"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:letterSpacing="0.3"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free Fire · OB53"
                android:textColor="#555555"
                android:textSize="10sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- STATUS CARD -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="#FF6B00"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/dotOverlay"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_inactive"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Overlay (desenhar sobre apps)"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendente"
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dotAccess"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_inactive"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acessibilidade (injetar gestos)"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAccessStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendente"
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PERMISSÕES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIGURAÇÃO"
                android:textColor="#FF6B00"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="1. Permitir overlay"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/btn_secondary"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="2. Ativar acessibilidade"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/btn_secondary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="INICIAR SERVIÇO"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_primary"
                android:layout_marginBottom="8dp"
                android:enabled="false" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Parar serviço"
                android:textColor="#888888"
                android:textSize="13sp"
                android:background="@drawable/btn_ghost" />
        </LinearLayout>

        <!-- ARMAS ATIVAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PERFIS"
                    android:textColor="#FF6B00"
                    android:textSize="10sp"
                    android:letterSpacing="0.2" />

                <TextView
                    android:id="@+id/tvActiveWeapon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhuma"
                    android:textColor="#FF6B00"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- AR Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AR"
                android:textColor="#555555"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/rowAR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp" />

            <!-- SMG Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMG"
                android:textColor="#555555"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/rowSMG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp" />

            <!-- LMG Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LMG"
                android:textColor="#555555"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/rowLMG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- INSTRUÇÕES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMO USAR"
                android:textColor="#FF6B00"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:paddingBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="① Conceda as permissões acima\n② Selecione a arma na lista\n③ Inicie o serviço\n④ Abra o Free Fire\n⑤ Arraste o botão laranja sobre o fire do FF\n⑥ Ajuste o multiplicador no painel flutuante se necessário"
                android:textColor="#888888"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
